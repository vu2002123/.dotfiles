export PATH="$PATH:/opt/nvim/bin/"
export PATH="$PATH:$HOME/.local/bin/"
export PATH="$PATH:$HOME/go/bin/"
export PATH="$PATH:$HOME/opt/"
export PATH="$PATH:$HOME/.cargo/bin/"

# >>> conda initialize >>>
# !! Contents within this block are managed by 'conda init' !!
__conda_setup="$('/home/vu2002123/miniconda3/bin/conda' 'shell.bash' 'hook' 2> /dev/null)"
if [ $? -eq 0 ]; then
    eval "$__conda_setup"
else
    if [ -f "/home/vu2002123/miniconda3/etc/profile.d/conda.sh" ]; then
        . "/home/vu2002123/miniconda3/etc/profile.d/conda.sh"
    else
        export PATH="/home/vu2002123/miniconda3/bin:$PATH"
    fi
fi
unset __conda_setup
# <<< conda initialize <<<

